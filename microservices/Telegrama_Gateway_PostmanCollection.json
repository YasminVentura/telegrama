{
  "info": {
    "name": "Telegrama - API Gateway (Fluxo Completo)",
    "description": "Coleção de rotas simulando as requisições feitas pelo Front-End passando pelo API Gateway na porta 8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Registrar Usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Yasmin Ventura\",\n  \"nodeId\": \"@yasmin_v\",\n  \"email\": \"yasmin@exemplo.com\",\n  \"senha\": \"SenhaForte@123\",\n  \"termosAceitos\": true\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/registro",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "auth",
                "registro"
              ]
            }
          }
        },
        {
          "name": "2. Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"@yasmin_v\",\n  \"senha\": \"SenhaForte@123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const sessionHeader = pm.response.headers.get('X-Session-Id');",
                  "if (sessionHeader) {",
                  "    pm.collectionVariables.set('id_sessao', sessionHeader);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "idSessao={{id_sessao}}",
                "type": "text"
              },
              {
                "key": "X-Session-Id",
                "value": "{{id_sessao}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/auth/logout",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Usuários",
      "item": [
        {
          "name": "3. Buscar Perfil (Público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/usuarios/@yasmin_v",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "usuarios",
                "@yasmin_v"
              ]
            }
          }
        },
        {
          "name": "4. Excluir Conta (Requer Token)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "idSessao={{id_sessao}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/usuarios/@yasmin_v",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "usuarios",
                "@yasmin_v"
              ]
            }
          }
        },
        {
          "name": "5. Seguir Usuário (Requer Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "idSessao={{id_sessao}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/usuarios/@outro_usuario/seguir",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "usuarios",
                "@outro_usuario",
                "seguir"
              ]
            }
          }
        },
        {
          "name": "6. Deixar de Seguir (Requer Token)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "idSessao={{id_sessao}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/usuarios/@outro_usuario/seguir",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "usuarios",
                "@outro_usuario",
                "seguir"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Postagens",
      "item": [
        {
          "name": "7. Criar Postagem (Requer Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "idSessao={{id_sessao}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Primeira transmissão retroverse com MongoDB!\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/posts",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "posts"
              ]
            }
          }
        },
        {
          "name": "8. Listar Postagens (Feed Paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/posts?page=1&limit=20",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "9. Buscar Postagem por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/posts/COLE_O_ID_AQUI",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "posts",
                "COLE_O_ID_AQUI"
              ]
            }
          }
        },
        {
          "name": "10. Curtir / Descurtir (Requer Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "idSessao={{id_sessao}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/posts/COLE_O_ID_AQUI/curtir",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "posts",
                "COLE_O_ID_AQUI",
                "curtir"
              ]
            }
          }
        },
        {
          "name": "11. Excluir Postagem (Requer Token - Apenas Autor)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "idSessao={{id_sessao}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/posts/COLE_O_ID_AQUI",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "posts",
                "COLE_O_ID_AQUI"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "id_sessao",
      "value": "COLE_O_ID_SESSAO_AQUI_SE_POSTMAN_NAO_SALVAR",
      "type": "string"
    }
  ]
}
