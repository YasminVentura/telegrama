{
  "info": {
    "name": "Telegrama - API Gateway (Fluxo Completo)",
    "description": "Coleção de rotas simulando as requisições feitas pelo Front-End passando pelo API Gateway na porta 8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Registrar Usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Yasmin Ventura\",\n  \"nodeId\": \"@yasmin_v\",\n  \"email\": \"yasmin@exemplo.com\",\n  \"senha\": \"SenhaForte@123\",\n  \"termosAceitos\": true\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/registro",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "auth",
                "registro"
              ]
            }
          }
        },
        {
          "name": "2. Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"@yasmin_v\",\n  \"senha\": \"SenhaForte@123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Usuários",
      "item": [
        {
          "name": "3. Buscar Perfil (Público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/usuarios/@yasmin_v",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "usuarios",
                "@yasmin_v"
              ]
            }
          }
        },
        {
          "name": "4. Excluir Conta (Requer Token)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/usuarios/@yasmin_v",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "usuarios",
                "@yasmin_v"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "jwt_token",
      "value": "COLE_O_TOKEN_GERADO_NO_LOGIN_AQUI",
      "type": "string"
    }
  ]
}
